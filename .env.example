# Copy to .env for local Docker runs. Render sets SEARXNG_SECRET itself.
# Generate one with: openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-long-random-string

# Optional: absolute public URL, e.g. https://searxng.onrender.com
# Leave unset on Render; SearXNG derives it from the request Host header.
SEARXNG_BASE_URL=

# Local only. Render injects PORT automatically (default 10000).
PORT=8080
